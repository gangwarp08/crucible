{
  "name": "@crucible/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "regression": "tsx scripts/regression.ts"
  },
  "dependencies": {
    "@crucible/shared": "workspace:*",
    "@e2b/code-interpreter": "^1.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@supabase/supabase-js": "^2.44.0",
    "dotenv": "^16.4.0",
    "e2b": "^1.13.2",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "undici": "^6.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.21.0"
  }
