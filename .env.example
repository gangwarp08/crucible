# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>          # server-only
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>              # safe for browser

# --- LiteLLM gateway (Railway) ---
LITELLM_BASE_URL=https://<your-litellm>.railway.app
LITELLM_MASTER_KEY=<master_key>                       # server-only; never NEXT_PUBLIC_

# --- E2B sandbox ---
E2B_API_KEY=<e2b_api_key>                             # server-only

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Session limits (Hard Rules §5) ---
SESSION_BUDGET_USD=1.00
SESSION_TIMEOUT_MIN=60

# --- Server ---
PORT=3001
HOST=0.0.0.0
JWT_SECRET=<at_least_32_random_chars>
# Comma-separated list of allowed browser origins. Required in production.
# Example: WEB_ORIGIN=https://crucible.vercel.app,https://crucible-preview.vercel.app
WEB_ORIGIN=http://localhost:3000
# Shared invite code required to start a session. When unset, the gate is off
# (dev/preview). Set in production to keep stray URL hits from burning budget.
# INVITE_CODE=crucible-beta-2026

# --- Next.js ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
